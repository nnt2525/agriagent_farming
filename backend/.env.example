# Server
PORT=8080

# Set to false once DATABASE_URL points at a real Postgres/Supabase instance.
# While true, the API serves seeded in-memory mock data (no DB required).
MOCK_MODE=true
DATABASE_URL=postgres://user:password@host:5432/agriagent?sslmode=require

# MQTT (HiveMQ Cloud or any TLS broker). Leave blank to skip live telemetry.
MQTT_BROKER_URL=tls://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=agriagent-backend
MQTT_TOPIC=agriagent/+/telemetry

# LLM agent. Leave blank to use the offline rule-based MockClient.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agent trigger thresholds
SOIL_MOISTURE_LOW_PCT=30
SOIL_MOISTURE_DELTA_PCT=10
AGENT_SCHEDULE_INTERVAL=3h
